import json

def file_to_json_entry(filename):
    with open(filename, 'r', encoding='utf-8') as f:
        content = f.read()
    return {
        "name": filename,
        "content": content
    }

files = ["app.py"]  # add more files if needed

project_json = [file_to_json_entry(f) for f in files]

with open("project_bundle.json", "w", encoding='utf-8') as f:
    json.dump(project_json, f, indent=2)

